# Firebase Web app configuration (public client settings; enable Google sign-in in Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set true only when running the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Server-only. Required for general AI responses; never use a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
